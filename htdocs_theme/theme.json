{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1440px"
		},
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary-saffron", "color": "#FF9933", "name": "Primary Saffron" },
				{ "slug": "deep-saffron", "color": "#E68A2E", "name": "Deep Saffron" },
				{ "slug": "indigo", "color": "#1A237E", "name": "Indigo" },
				{ "slug": "deep-indigo", "color": "#121858", "name": "Deep Indigo" },
				{ "slug": "sand", "color": "#F4ECE6", "name": "Sand / Warm Neutral" },
				{ "slug": "cream", "color": "#FDFBF7", "name": "Cream" },
				{ "slug": "surface", "color": "#FFFFFF", "name": "Surface" },
				{ "slug": "surface-elevated", "color": "#FFFFFF", "name": "Surface Elevated" },
				{ "slug": "text-primary", "color": "#1C1B1A", "name": "Text Primary" },
				{ "slug": "text-secondary", "color": "#4A4744", "name": "Text Secondary" },
				{ "slug": "text-muted", "color": "#75716C", "name": "Text Muted" },
				{ "slug": "border", "color": "#E5E1DB", "name": "Border" },
				{ "slug": "success", "color": "#2E7D32", "name": "Success" },
				{ "slug": "warning", "color": "#F57C00", "name": "Warning" },
				{ "slug": "error", "color": "#D32F2F", "name": "Error" },
				{ "slug": "focus", "color": "#2196F3", "name": "Focus" }
			]
		},
		"typography": {
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "base", "size": "1rem", "name": "Base" },
				{ "slug": "medium", "size": "1.25rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5625rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.953rem", "name": "Extra Large" },
				{ "slug": "xx-large", "size": "2.441rem", "name": "XX Large" }
			],
			"fontFamilies": [
				{
					"fontFamily": "\"Noto Serif\", serif",
					"slug": "display-serif",
					"name": "Display Serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/noto-serif-v22-latin-regular.woff2"]
						},
						{
							"fontFamily": "Noto Serif",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/noto-serif-v22-latin-700.woff2"]
						}
					]
				},
				{
					"fontFamily": "\"Inter\", sans-serif",
					"slug": "ui-sans",
					"name": "UI Sans-Serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/inter-v12-latin-regular.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/inter-v12-latin-500.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/inter-v12-latin-600.woff2"]
						}
					]
				}
			]
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{ "name": "1 (4px)", "size": "0.25rem", "slug": "1" },
				{ "name": "2 (8px)", "size": "0.5rem", "slug": "2" },
				{ "name": "3 (12px)", "size": "0.75rem", "slug": "3" },
				{ "name": "4 (16px)", "size": "1rem", "slug": "4" },
				{ "name": "6 (24px)", "size": "1.5rem", "slug": "6" },
				{ "name": "8 (32px)", "size": "2rem", "slug": "8" },
				{ "name": "12 (48px)", "size": "3rem", "slug": "12" },
				{ "name": "16 (64px)", "size": "4rem", "slug": "16" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--text-primary)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ui-sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary-saffron)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "8px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--3)",
						"bottom": "var(--wp--preset--spacing--3)",
						"left": "var(--wp--preset--spacing--6)",
						"right": "var(--wp--preset--spacing--6)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary-saffron)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display-serif)",
					"lineHeight": "1.2",
					"color": "var(--wp--preset--color--text-primary)"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "front-page",
			"title": "Homepage (Prakash Marg)",
			"postTypes": ["page"]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Global Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Global Footer",
			"area": "footer"
		}
	]
}
