{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"useRootPaddingAwareAlignments": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary-green", "color": "#1a3a2e", "name": "Forest Green" },
				{ "slug": "secondary-green", "color": "#4a9472", "name": "Light Green" },
				{ "slug": "primary-gold", "color": "#b8943a", "name": "Classic Gold" },
				{ "slug": "secondary-gold", "color": "#d4aa50", "name": "Light Gold" },
				{ "slug": "bg-ivory", "color": "#f8f4ee", "name": "Ivory Background" },
				{ "slug": "bg-soft-green", "color": "#eef4f0", "name": "Soft Green Background" },
				{ "slug": "text-main", "color": "#2c1a0e", "name": "Text Main" },
				{ "slug": "text-soft", "color": "#9a7e6a", "name": "Text Soft" },
				{ "slug": "neutral-0", "color": "#FFFFFF", "name": "White" }
			]
		},
		"typography": {
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "base", "size": "1rem", "name": "Base" },
				{ "slug": "medium", "size": "1.25rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5625rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.953rem", "name": "Extra Large" },
				{ "slug": "xx-large", "size": "2.441rem", "name": "XX Large" }
			],
			"fontFamilies": [
				{
					"fontFamily": "\"Tiro Devanagari Hindi\", serif",
					"slug": "display-serif",
					"name": "Display Serif"
				},
				{
					"fontFamily": "\"Mukta\", sans-serif",
					"slug": "ui-sans",
					"name": "UI Sans-Serif"
				}
			]
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{ "name": "1 (4px)", "size": "0.25rem", "slug": "1" },
				{ "name": "2 (8px)", "size": "0.5rem", "slug": "2" },
				{ "name": "3 (12px)", "size": "0.75rem", "slug": "3" },
				{ "name": "4 (16px)", "size": "1rem", "slug": "4" },
				{ "name": "6 (24px)", "size": "1.5rem", "slug": "6" },
				{ "name": "8 (32px)", "size": "2rem", "slug": "8" },
				{ "name": "12 (48px)", "size": "3rem", "slug": "12" },
				{ "name": "16 (64px)", "size": "4rem", "slug": "16" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg-ivory)",
			"text": "var(--wp--preset--color--text-main)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ui-sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary-green)",
					"text": "var(--wp--preset--color--neutral-0)"
				},
				"border": {
					"radius": "8px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--3)",
						"bottom": "var(--wp--preset--spacing--3)",
						"left": "var(--wp--preset--spacing--6)",
						"right": "var(--wp--preset--spacing--6)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary-green)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display-serif)",
					"lineHeight": "1.2"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display-serif)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--primary-gold)",
						"width": "4px",
						"style": "solid"
					}
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "front-page",
			"title": "Homepage (Prakash Marg)",
			"postTypes": ["page"]
		},
		{
			"name": "page-panchang",
			"title": "Panchang Calendar",
			"postTypes": ["page"]
		},
		{
			"name": "page-quote",
			"title": "Quote of the Day",
			"postTypes": ["page"]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Global Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Global Footer",
			"area": "footer"
		}
	]
}
